module(
    name = "llvm-project",
    version = "20.0.0",
)

# Core dependencies from Bazel Central Registry
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "rules_python", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.11.1")
bazel_dep(name = "platforms", version = "0.0.10")

# Apple support
bazel_dep(name = "apple_support", version = "1.15.1", repo_name = "build_bazel_apple_support")

# Shell rules for tests
bazel_dep(name = "rules_shell", version = "0.6.1")

# Register Python toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

# Local repository for LLVM source
llvm_raw = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
llvm_raw(
    name = "llvm-raw",
    build_file_content = "# empty",
    path = "../../",
)

# Configure LLVM project (this loads the configure.bzl)
# Note: This is a repository rule that needs to be loaded from WORKSPACE or via non_module_dependencies
# For now, this will be handled through WORKSPACE compatibility layer

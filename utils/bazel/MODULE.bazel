module(
    name = "llvm-project",
    version = "20.0.0",
)

# Core dependencies from Bazel Central Registry
# Note: These versions are synchronized with WORKSPACE for consistency.
# The hybrid bzlmod + WORKSPACE mode requires bzlmod to be enabled.
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "rules_python", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.11.1")
bazel_dep(name = "platforms", version = "0.0.10")

# Apple support
bazel_dep(name = "apple_support", version = "1.15.1", repo_name = "build_bazel_apple_support")

# Shell rules for tests
bazel_dep(name = "rules_shell", version = "0.6.1")

# Register Python toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

# IMPORTANT: LLVM Bazel build requires hybrid bzlmod + WORKSPACE mode
# The llvm-raw and llvm-project repositories are defined in WORKSPACE because:
# 1. The module name is "llvm-project", preventing creation of a repository with the same name
# 2. The llvm_configure repository rule creates an overlay of BUILD files on the LLVM source
# 3. This approach maintains compatibility with existing downstream consumers
#
# To build LLVM, you MUST use both --enable_bzlmod and --enable_workspace flags.
# These flags are set by default in .bazelrc. Using --noenable_workspace will cause
# build failures with errors like "Repository '@@llvm-project' is not defined".
#
# WORKSPACE-defined repositories (llvm-raw, llvm-project) are accessible
# using canonical names (@@repo_name) in Bazel 7.x hybrid mode.

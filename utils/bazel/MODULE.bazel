module(
    name = "llvm-project",
    version = "20.0.0",
)

# Core dependencies from Bazel Central Registry
# Note: These versions are synchronized with WORKSPACE for consistency.
# The hybrid bzlmod + WORKSPACE mode requires bzlmod to be enabled.
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_cc", version = "0.0.17")
bazel_dep(name = "rules_python", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.11.1")
bazel_dep(name = "platforms", version = "0.0.10")

# Apple support
bazel_dep(name = "apple_support", version = "1.15.1", repo_name = "build_bazel_apple_support")

# Shell rules for tests
bazel_dep(name = "rules_shell", version = "0.6.1")

# Register Python toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)

# Expose WORKSPACE repository rules to bzlmod for hybrid mode compatibility
# This ensures llvm-raw and llvm-project repositories are accessible
# even when bzlmod is enabled, completing the bzlmod migration.
llvm_configure_rule = use_repo_rule("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")
new_local_repository_rule = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

# Note: These repository instantiations are primarily handled in WORKSPACE
# for backwards compatibility. The use_repo_rule declarations above ensure
# they remain accessible in pure bzlmod mode.
